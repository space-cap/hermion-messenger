# ==============================================================================
# hermion-messenger 로컬 환경변수 설정 예시 파일 (.env.example)
# 복사하여 .env 파일을 생성한 뒤 실제 API Key 값을 채워 사용하세요.
# ==============================================================================

# 1. 키움 REST API 설정 (kiwoom-rest-trade SDK 연동용)
KIWOOM_APP_KEY="your_kiwoom_app_key_here"
KIWOOM_SECRET_KEY="your_kiwoom_secret_key_here"
KIWOOM_IS_MOCK=true  # true: 모의투자 모드, false: 실거래 모드

# 2. DART Open API 설정 (공시 수집용)
DART_API_KEY="your_dart_api_key_here"

# 3. Anthropic Claude API 설정 (LLM 브리핑 생성용)
ANTHROPIC_API_KEY="your_claude_api_key_here"

# 4. 데이터베이스 설정 (SQLite DB 파일 경로)
DATABASE_URL="sqlite:///./data.db"

# 5. 발송 채널 설정 (SMTP / 알림톡)
# 이메일 발송용 SMTP 설정 (AWS SES 등 사용 시 업데이트)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USERNAME="your_smtp_username"
SMTP_PASSWORD="your_smtp_password"
SMTP_FROM_EMAIL="sender@example.com"

# 카카오 알림톡 설정 (비즈엠 등 서비스 이용 시 API Key)
BIZM_API_KEY="your_bizm_api_key_here"
BIZM_SENDER_PROFILE_KEY="your_sender_profile_key_here"
